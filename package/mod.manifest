<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Controller Tweaks and Remap</name>
    <modid>ControllerTweaksAndRemap</modid>
    <description>Configure controller bindings with an INI, swap shoulders and triggers, enjoy a wider walking range, and use short press Map / long press Game Hub. Requires UE4SS.</description>
    <author>Local compatibility mod</author>
    <version>1.5.1</version>
    <created_on>2026-09-05</created_on>
  </info>
  <supports>
    <requires>UE4SS with TMap and LoopInGameThreadWithDelay (reference 97b7e501c)</requires>
    <game>The Blood of Dawnwalker</game>
    <steam_build>25129649</steam_build>
    <executable>dw1-pc-257186-shipping-patch2-all</executable>
    <unreal_engine>5.5.4</unreal_engine>
  </supports>
</mod>
