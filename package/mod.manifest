<?xml version="1.0" encoding="utf-8"?>
<mod>
  <info>
    <name>Dawnwalker Controller Tweaks</name>
    <modid>DawnwalkerControllerTweaks</modid>
    <description>Swaps LB/LT and RB/RT, preserves map and hub shortcuts, and adds a Start press compass reveal using HUDTweaks idle-fade settings.</description>
    <author>Local compatibility mod</author>
    <version>1.1.2</version>
    <created_on>2026-09-05</created_on>
  </info>
  <supports>
    <game>The Blood of Dawnwalker</game>
    <steam_build>25129649</steam_build>
    <executable>dw1-pc-257186-shipping-patch2-all</executable>
    <unreal_engine>5.5.4</unreal_engine>
    <requires>HUDTweaks v2 and a working Dawnwalker UE4SS installation</requires>
  </supports>
</mod>
